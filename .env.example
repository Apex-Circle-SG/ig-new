# Copy to .env.local in apps/web only when needed; never commit secrets.
NEXT_PUBLIC_SITE_URL=https://insightginie.com
SITE_INDEXABLE=false
DATABASE_URL=
REDIS_URL=
CENSUS_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
FRED_API_KEY=
HUD_API_KEY=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:insightginie.com
BING_WEBMASTER_API_KEY=
INDEXNOW_KEY=
ANALYTICS_DIRECTORY=
ANALYTICS_SITE_ORIGIN=https://insightginie.com
APP_SITE_ORIGIN=https://insightginie.com
OPERATIONS_DIRECTORY=
ASK_ENABLED=true
# 64 hex characters; generate locally. Essential CSRF protection, not a model key.
ASK_SECURITY_SECRET=
ADMIN_USERNAME=admin
# Long generated server-only secret. /admin/ stays unavailable without it.
ADMIN_ACCESS_KEY=
# Datadog credentials are server-only. Never use NEXT_PUBLIC or commit populated values.
DD_REGION=AP1
DD_API_KEY=
DD_APP_KEY=
DD_AGENT_ID=
DD_BITS_WORKFLOW_ID=
# Source selection sends only fixed public excerpts. General questions are a separate opt-in.
ASK_DATADOG_ENABLED=false
# General answers require an explicit authorization bound to this exact agent.
ASK_DATADOG_GENERAL_ENABLED=false
# Preferred: operator attests tools are disabled. Must equal DD_AGENT_ID.
ASK_DATADOG_TOOL_FREE_AGENT_ID=
# Alternative: owner explicitly authorizes this agent with unverified tool settings.
# This does not attest isolation; must equal DD_AGENT_ID. Never put an ID in browser env.
ASK_DATADOG_PUBLIC_AGENT_ID=
ASK_DATADOG_STATE_DIRECTORY=
ASK_DATADOG_MAX_DAILY_RUNS=20
ASK_DATADOG_MAX_MONTHLY_RUNS=120
DD_METRICS_ENABLED=false
DD_BITS_ENABLED=false
DD_BITS_WORKFLOW_REVIEWED=false
DD_BITS_BUDGET_CONFIRMED=false
DD_BITS_MAX_MONTHLY_RUNS=0
DD_BITS_MONTHLY_CREDIT_BUDGET=0
DD_BITS_RESERVED_CREDITS_PER_RUN=0
OBSERVABILITY_STATE_DIRECTORY=
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADS_ENABLED=false
ADSENSE_CLIENT_ID=ca-pub-8735749779872017
SENTRY_DSN=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
