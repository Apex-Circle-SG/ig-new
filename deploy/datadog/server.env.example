# Server-only template. Copy outside Git; do not put these values in Next public env.
DD_SITE=ap1.datadoghq.com
# DD_REGION=AP1 is an accepted application alias.
DD_API_KEY=
DD_APP_KEY=
DD_ENV=production
DD_SERVICE=insightginie-web
OPERATIONS_DIRECTORY=/var/lib/insightginie/operations
OBSERVABILITY_STATE_DIRECTORY=/var/lib/insightginie/observability
DD_METRICS_ENABLED=false
DD_APM_ENABLED=false
DD_TRACE_ENABLED=false
DD_LOGS_INJECTION=false
DD_RUNTIME_METRICS_ENABLED=false
DD_PROFILING_ENABLED=false
DD_DYNAMIC_INSTRUMENTATION_ENABLED=false
DD_EXCEPTION_REPLAY_ENABLED=false
DD_BITS_ENABLED=false
DD_BITS_AGENT_ID=
# DD_AGENT_ID is an accepted application alias.
DD_BITS_WORKFLOW_ID=
DD_BITS_WORKFLOW_REVIEWED=false
DD_BITS_BUDGET_CONFIRMED=false
DD_BITS_MAX_MONTHLY_RUNS=0
DD_BITS_MONTHLY_CREDIT_BUDGET=0
DD_BITS_RESERVED_CREDITS_PER_RUN=0
