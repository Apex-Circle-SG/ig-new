{
  "name": "insightginie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @insightginie/web",
    "build": "npm run build --workspace @insightginie/web",
    "start": "npm run start --workspace @insightginie/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm test && NEXT_PUBLIC_ADS_ENABLED=true npm run build && npm run test:e2e",
    "ingest:census": "tsx apps/ingest/src/census.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "audit:legacy": "python3 scripts/legacy-url-audit/crawl.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.5.3",
    "lighthouse": "^13.0.3",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
